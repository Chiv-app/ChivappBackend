# ========================================================
# CHIVAPP BACKEND - VARIABLES DE ENTORNO PARA PRODUCCIÓN
# Dominio: chiv.app
# ========================================================

# production: desactiva /docs y los orígenes CORS de desarrollo
ENVIRONMENT=production

PROJECT_NAME="Chivapp API"
API_V1_STR="/api/v1"

# Base de datos Cloud SQL PostgreSQL
# Formato: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# O socket Cloud SQL: postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@/<DB_NAME>?host=/cloudsql/<PROJECT_ID>:<REGION>:<INSTANCE_NAME>
SQLALCHEMY_DATABASE_URI=postgresql://chivapp_user:TU_PASSWORD_AQUI@/cloudsql/TU_PROYECTO:us-central1:chivapp-db/chivapp_prod

# Clave secreta JWT (generar con: openssl rand -hex 32)
JWT_SECRET_KEY=CAMBIAR_POR_HASH_ALEATORIO_64_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dominios autorizados para CORS
BACKEND_CORS_ORIGINS=["https://chiv.app", "https://www.chiv.app", "https://api.chiv.app"]

# URLs públicas del Frontend y Auth
FRONTEND_URL=https://chiv.app
OAUTH_REDIRECT_BASE_URL=https://chiv.app/api/v1

# Autenticación Social (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Envío de Emails transaccionales con Brevo
BREVO_API_KEY=xkeysib-TU_API_KEY_DE_BREVO
RESEND_API_KEY=re_TU_API_KEY_DE_RESEND
EMAIL_FROM="Chivapp <notificaciones@chiv.app>"
EMAIL_ENABLED=True

# Seguridad & Rate Limiting
RATE_LIMITING_ENABLED=True
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_REGISTER="10/minute"
RATE_LIMIT_PASSWORD_RESET="5/minute"
RATE_LIMIT_DEFAULT="120/minute"
RATE_LIMIT_PUBLIC=30/minute
# Con varias instancias de Cloud Run usar Redis (Memorystore): redis://HOST:6379
RATE_LIMIT_STORAGE_URI=memory://
# Mismo valor que PROXY_SHARED_SECRET del frontend (openssl rand -hex 32)
PROXY_SHARED_SECRET=

# Google Calendar (cuenta de servicio): JSON completo desde Secret Manager
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=

ENABLE_HSTS=True

# ========================================================
# MERCADO PAGO - CREDENCIALES DE PRODUCCIÓN
# Obtener de: https://www.mercadopago.com/developers/panel/app
# ========================================================
MERCADO_PAGO_PUBLIC_KEY=APP_USR-TU_PUBLIC_KEY_PRODUCCION
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-TU_ACCESS_TOKEN_PRODUCCION
MERCADO_PAGO_WEBHOOK_SECRET=TU_WEBHOOK_SECRET_DE_MERCADO_PAGO
MERCADO_PAGO_SANDBOX=False
MERCADO_PAGO_WEBHOOK_BASE_URL=https://api.chiv.app
