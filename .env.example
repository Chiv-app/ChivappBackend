# Entorno (en producción usar ENVIRONMENT=production)
ENVIRONMENT=development

# PostgreSQL
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://postgres:postgres@localhost:5432/musicdb

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS — JSON array de orígenes del frontend
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3002"]

# OAuth (Google / Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# URL pública del API vista por el navegador (proxy Next en local)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:3000

# Resend (correos transaccionales)
RESEND_API_KEY=
EMAIL_FROM=Chivapp <soporte@chiv.app>
EMAIL_ENABLED=true
